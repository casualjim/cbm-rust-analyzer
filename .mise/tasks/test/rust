#!/usr/bin/env bash

#MISE description="Run the Rust tests for this project"
#MISE sources=["Cargo.toml", "src/**/*.rs"]
#USAGE flag "--features <features>" help="Extra Cargo features to prepend before the default Ladybug features"

echo "🚀 Starting Crumbs Rust tests..."
proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

default_features="crumbs/ladybug,crumbs-cli/ladybug"
features="${default_features}"
if [[ -n "${usage_features:-}" ]]; then
  features="${usage_features},${default_features}"
fi

cargo nextest run --workspace --no-default-features --features "${features}"
